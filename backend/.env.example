PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cricketclash
JWT_SECRET=replace_with_a_long_random_secret_string
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
CRICKET_API_KEY=PASTE_YOUR_ACTUAL_API_KEY_HERE
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=-1004406740305
# Session absolute lifetimes; idle timeout remains 15 minutes.
PLAYER_SESSION_MAX_LIFETIME_MS=86400000
ADMIN_SESSION_MAX_LIFETIME_MS=28800000
# Brevo SMTP credentials used by registration, verification, and notification email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=CricketClash
# Optional Brevo HTTP API key. Prefer this on hosts that block SMTP ports (for example, Render Free).
BREVO_API_KEY=your_brevo_api_key
# Optional override for notifications sent after a new user's OTP is verified.
REGISTRATION_NOTIFICATION_EMAIL=kotariswamy1@gmail.com
# Admin deposit and withdrawal email recipient. If omitted, the verified admin
# account email is used. Configure this for a separate notification inbox.
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Optional Gmail fallback when SMTP_* settings are not configured.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password
